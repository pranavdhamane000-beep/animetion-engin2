        "crf": 28,
        "preset": "veryfast",
        "gop_frames": 48,
        "codec_profile": "high",
        "codec_level": "4.1",
        "color": { "primaries": "bt709", "transfer": "bt709", "matrix": "bt709", "range": "tv" },
        "audio": { "bitrate_kbps": 128, "sample_rate": 48000 }
      }
    },
